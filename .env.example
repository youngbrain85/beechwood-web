# Supabase connection values. Copy this file to `.env` (git-ignored) and fill in the project URL
# and the publishable (anon) key. While either value is REPLACE_ME the app connects to no
# database; use fixture mode (`npm run dev:fixtures`) to see the screens without one.
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_KEY=REPLACE_ME
