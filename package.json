{
  "name": "beechwood-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "node scripts/dev-fx.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "check": "vite build --outDir dist-check && node scripts/check-bundle-text.mjs dist-check && node scripts/verify-dist.mjs dist-check",
    "shots": "node scripts/dev-shots.mjs",
    "pipeline:model": "node scripts/beechwood/add-model.mjs",
    "pipeline:sheets": "node scripts/beechwood/sync-sheets.mjs",
    "pipeline:fixtures": "node scripts/beechwood/sync-fixtures.mjs",
    "pipeline:verify": "node scripts/beechwood/verify-pipeline.mjs"
  },
  "dependencies": {
    "@mantine/charts": "^8.1.0",
    "@mantine/core": "^8.1.0",
    "@mantine/hooks": "^8.1.0",
    "@supabase/supabase-js": "^2.110.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.4",
    "meshoptimizer": "^0.22.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.1"
  }
}
